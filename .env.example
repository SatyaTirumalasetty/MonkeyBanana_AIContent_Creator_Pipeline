# REQUIRED: Google AI Studio key for rhyme/storyboard/script generation (Gemini)
# Get your key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# REQUIRED: fal.ai API key for Kling AI video generation (image/text-to-video)
# Get your key at https://fal.ai/dashboard/keys
FAL_KEY=fal_your_key_here

# REQUIRED for video rendering: Vercel Blob storage for generated clips/final video
# Create a Blob store in the Vercel dashboard (Storage tab) or via:
#   vercel marketplace -- create blob store
# then `vercel env pull` to populate this automatically.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# OPTIONAL: Long-form video tuning.
# Each Kling clip is 5s. Increase clips for longer videos (each takes ~2-4 min).
# Default: 12 clips = ~60s final video.
# VIDEO_CLIP_DURATION_SEC=5
# VIDEO_TARGET_DURATION_SEC=60

# OPTIONAL: Social media posting
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=
# TIKTOK_ACCESS_TOKEN=
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
