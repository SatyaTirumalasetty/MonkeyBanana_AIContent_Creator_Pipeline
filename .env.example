# REQUIRED: Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPTIONAL: Real video generation via Google Veo 2
# Get your key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-google-ai-studio-key-here

# REQUIRED for video rendering: Vercel Blob storage for generated clips/final video
# Create a Blob store in the Vercel dashboard (Storage tab) or via:
#   vercel marketplace -- create blob store
# then `vercel env pull` to populate this automatically.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# OPTIONAL: Long-form video rendering tuning.
# Veo generates ONE CLIP AT A TIME (max ~8s each); a long video is assembled
# from many clips stitched together with ffmpeg. NUM_CLIPS = ceil(target / clip).
# COST/TIME WARNING: at the 300s default this is ~38 Veo generations per video
# (each takes 1-6 min and is billed per second of video) -- a single 5-minute
# video can take well over an hour to render and cost roughly $50-150 in Veo
# usage. Lower VIDEO_TARGET_DURATION_SEC (e.g. 32) for quick/cheap test runs.
# VIDEO_CLIP_DURATION_SEC=8
# VIDEO_TARGET_DURATION_SEC=300

# OPTIONAL: Social media posting
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=
# TIKTOK_ACCESS_TOKEN=
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
