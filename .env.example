# REQUIRED: Google AI Studio key for all AI agents (Gemini 2.5 Flash Lite)
# Agents: Content Creator, Reviewer, Storyboard Planner, Video Producer, Quality Director, Social Publisher
# Get your key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# REQUIRED: fal.ai API key for Kling AI video generation (text-to-video + image-to-video)
# Without this, the pipeline falls back to a canvas slideshow (no cost, no API needed)
# Get your key at https://fal.ai/dashboard/keys
FAL_KEY=fal_your_key_here

# REQUIRED for video rendering: Vercel Blob storage for generated clips/final video
# Create a Blob store in the Vercel dashboard (Storage tab), then `vercel env pull` to populate.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# OPTIONAL: Long-form video tuning.
# Each Kling clip is 5s. Increase clips for longer videos (each takes ~2-4 min on fal.ai).
# Default: 12 clips = ~60s final video.
# VIDEO_CLIP_DURATION_SEC=5
# VIDEO_TARGET_DURATION_SEC=60

# OPTIONAL: Social media posting
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=
# TIKTOK_ACCESS_TOKEN=
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
